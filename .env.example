APP_NAME=CondoConecta
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=condoconecta
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=condoconecta_session

# Use "log" em desenvolvimento e "mail" na hospedagem com PHP mail() habilitado.
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@seudominio.com.br
MAIL_FROM_NAME=CondoConecta

# Segredo local usado somente para hash de evidência técnica de aceite dos termos.
TERMS_AUDIT_SECRET=troque-por-um-segredo-longo

# Mercado Pago — nunca versionar credenciais reais.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
